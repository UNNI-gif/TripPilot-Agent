# TripPilot Agent Environment Configuration
# Copy this file to backend/.env or use these variables for Docker Compose / Local Dev

PROJECT_NAME="TripPilot Agent"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# AI Engine Configuration
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# Database Configuration (SQLite default; PostgreSQL supported)
DATABASE_URL="sqlite:///./trippilot.db"

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
